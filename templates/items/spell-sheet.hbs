{{! systems/mythras-imperative/templates/items/spell-sheet.hbs }}
<div class="mi-item-sheet-body">

  {{! ── HEADER ─────────────────────────────────────────────────────────── }}
  <header class="mi-item-header">
    <img class="mi-item-img" src="{{item.img}}" data-edit="img" data-action="editImage" title="{{item.name}}"/>
    <div class="mi-item-title-block">
      <input class="mi-item-name" type="text" name="name" value="{{item.name}}"
             placeholder="Spell name"/>
      <div class="mi-item-subtitle">
        <span class="mi-item-type-pill">Spell</span>
      </div>
    </div>
  </header>

  {{! ── MAGIC TRAITS ────────────────────────────────────────────────────── }}
  <div class="mi-item-stats">
    <div class="mi-stat-cell">
      <div class="mi-stat-label">Concentration</div>
      <input type="checkbox" name="system.traits" value="concentration"
             {{#if (includes system.traits "concentration")}}checked{{/if}}
             class="mi-stat-checkbox"/>
    </div>
    <div class="mi-stat-cell">
      <div class="mi-stat-label">Instant</div>
      <input type="checkbox" name="system.traits" value="instant"
             {{#if (includes system.traits "instant")}}checked{{/if}}
             class="mi-stat-checkbox"/>
    </div>
    <div class="mi-stat-cell">
      <div class="mi-stat-label">Ranged</div>
      <input type="checkbox" name="system.traits" value="ranged"
             {{#if (includes system.traits "ranged")}}checked{{/if}}
             class="mi-stat-checkbox"/>
    </div>
    <div class="mi-stat-cell">
      <div class="mi-stat-label">Resist</div>
      <input type="checkbox" name="system.traits" value="resist"
             {{#if (includes system.traits "resist")}}checked{{/if}}
             class="mi-stat-checkbox"/>
    </div>
    <div class="mi-stat-cell">
      <div class="mi-stat-label">Touch</div>
      <input type="checkbox" name="system.traits" value="touch"
             {{#if (includes system.traits "touch")}}checked{{/if}}
             class="mi-stat-checkbox"/>
    </div>
  </div>

  {{#if hasResist}}
  <div class="mi-item-stats">
    <div class="mi-stat-cell">
      <div class="mi-stat-label">Resisted by</div>
      <select name="system.resistSkill" class="mi-stat-select">
        {{#select system.resistSkill}}
          <option value="">— none set —</option>
          <option value="endurance">Endurance</option>
          <option value="evade">Evade</option>
          <option value="willpower">Willpower</option>
          <option value="special">Special (not automated)</option>
        {{/select}}
      </select>
    </div>
  </div>
  {{/if}}

  <div class="mi-item-stats">
    <div class="mi-stat-cell">
      <div class="mi-stat-label">Duration</div>
      <input type="text" name="system.duration" value="{{system.duration}}"
             class="mi-stat-input" placeholder="Scene (default) — override for a custom duration"/>
    </div>
  </div>

  {{! ── DESCRIPTION ─────────────────────────────────────────────────────── }}
  <div class="mi-item-desc-block">
    <div class="mi-section-label">Rules Text</div>
    <textarea name="system.description" class="mi-item-desc mi-trait-desc"
              placeholder="Rules text from Mythras Imperative…">{{system.description}}</textarea>
  </div>

  {{! ── CAST ─────────────────────────────────────────────────────────────── }}
  {{#if actor}}
  <div class="mi-trait-graph-row">
    <button type="button" class="mi-btn mi-btn-cast-spell">
      <i class="fas fa-magic"></i> Cast Spell
      <span class="mi-muted">— {{actor.system.attributes.magicPoints.value}}/{{actor.system.attributes.magicPoints.max}} MP</span>
    </button>
  </div>
  {{else}}
  <div class="mi-trait-graph-row">
    <button class="mi-btn mi-btn--disabled" disabled title="Open this spell from an actor's sheet to cast it">
      <i class="fas fa-magic"></i> Cast Spell (no actor)
    </button>
  </div>
  {{/if}}

</div>
